TONKEEPER_ADDRESS=UQBxgeimks3cpRlPlGmAeRgDl-ydnC7YmlD1NpTcpVIqbonJ

# ──────────────────────────────────────────────────────────────
# Цена подписки в TON
# ──────────────────────────────────────────────────────────────
SUBSCRIPTION_PRICE=5

# ──────────────────────────────────────────────────────────────
# Длительность подписки в днях
# ──────────────────────────────────────────────────────────────
SUBSCRIPTION_DAYS=30

# ──────────────────────────────────────────────────────────────
# API-ключ TonCenter (рекомендуется, но необязательно)
# Бесплатно: https://toncenter.com/ → Login with Telegram → Get API Key
# Без ключа: лимит 1 запрос/сек. С ключом: 10 запросов/сек.
# ──────────────────────────────────────────────────────────────
TONCENTER_API_KEY=

# ──────────────────────────────────────────────────────────────
# Ссылка на закрытый канал, куда пускать подписчиков.
# Можно оставить пустой — тогда бот просто подтвердит оплату.
# ──────────────────────────────────────────────────────────────
SUBSCRIBER_CHANNEL_LINK=

# ──────────────────────────────────────────────────────────────
# Автопроверка платежей (в секундах). 0 = только по кнопке.
# Например, 60 = раз в минуту проверять TonCenter сам.
# ──────────────────────────────────────────────────────────────
AUTO_CHECK_INTERVAL=60
